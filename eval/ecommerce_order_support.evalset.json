          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Under ShopGuard policy POL-DAMAGED-60D, items that arrive damaged, defective, or wrong qualify for a full refund or replacement up to 60 days after delivery with waived return shipping fees, even on final-sale items."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "search_ecommerce_return_and_shipping_policies",
                "args": {
