# --- Authentication (Zero hardcoded secrets; fetched from Secret Manager in prod) ---
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# In Google Cloud production, GEMINI_API_KEY is injected via Google Cloud Secret Manager:
GEMINI_SECRET_ID=shopguard-gemini-api-key
# Local development fallback only (never commit real keys):
GOOGLE_API_KEY=

# --- Google Cloud & Vertex AI Settings ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AGENT_ENGINE_ID=
VERTEX_SEARCH_DATASTORE_ID=

# --- Strategic Model Routing ---
FAST_ROUTER_MODEL=gemini-2.5-flash
REASONING_PLANNER_MODEL=gemini-2.5-pro

# --- Memory & Session Persistence ("local" uses SQLite + ChromaDB; "vertex" uses Agent Engine) ---
MEMORY_BACKEND=local
SESSION_DB_URL=sqlite+aiosqlite:///./data/ecommerce_sessions.db
ECOMMERCE_STORE_DB_PATH=./data/ecommerce_store.db
CHROMA_PERSIST_DIR=./data/chroma_vector_store

# --- Security, Guardrails & Observability ---
HIGH_VALUE_REFUND_THRESHOLD_USD=100.0
ENABLE_CLOUD_DLP=false
ENABLE_CLOUD_TRACE=false
LOG_LEVEL=INFO
